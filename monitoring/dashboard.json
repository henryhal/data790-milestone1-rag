{
 "displayName": "Archivist - LLM service",
 "mosaicLayout": {
  "columns": 12,
  "tiles": [
   {
    "xPos": 0,
    "yPos": 0,
    "width": 12,
    "height": 2,
    "widget": {
     "title": "About this dashboard",
     "text": {
      "format": "MARKDOWN",
      "content": "**The Archivist (Destiny lore RAG) on Cloud Run.** Top rows: LLM metrics from the app's structured logs (log-based metrics). Bottom rows: Cloud Run's built-in container metrics. Alerts: `monitoring/alert_policies.json`. Runbook: `docs/RUNBOOK.md`."
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 2,
    "width": 4,
    "height": 4,
    "widget": {
     "title": "Questions per minute, by outcome",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/archivist_requests\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"archivist\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "metric.label.outcome"
           ]
          }
         }
        },
        "plotType": "STACKED_BAR",
        "minAlignmentPeriod": "60s",
        "legendTemplate": "${metric.labels.outcome}"
       }
      ],
      "timeshiftDuration": "0s",
      "yAxis": {
       "label": "questions",
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 4,
    "yPos": 2,
    "width": 4,
    "height": 4,
    "widget": {
     "title": "Answer latency p50 / p95 (ms)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/archivist_latency\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"archivist\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_DELTA",
           "crossSeriesReducer": "REDUCE_PERCENTILE_50"
          }
         }
        },
        "plotType": "LINE",
        "minAlignmentPeriod": "60s",
        "legendTemplate": "p50"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/archivist_latency\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"archivist\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_DELTA",
           "crossSeriesReducer": "REDUCE_PERCENTILE_95"
          }
         }
        },
        "plotType": "LINE",
        "minAlignmentPeriod": "60s",
        "legendTemplate": "p95"
       }
      ],
      "timeshiftDuration": "0s",
      "yAxis": {
       "label": "ms",
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 8,
    "yPos": 2,
    "width": 4,
    "height": 4,
    "widget": {
     "title": "LLM cost per question (USD, mean)",
